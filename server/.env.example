# SportSync Backend Environment Variables
PORT=5001
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/sportsync?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/sportsync

# JWT Secret Key for token signing
JWT_SECRET=super_secret_sportsync_jwt_key_change_in_production_2026

# Allowed Frontend URLs for CORS (comma separated if multiple)
CLIENT_URL=http://localhost:3000,https://sportsync.pages.dev
